# Paste into Dokploy -> your Compose app -> Environment. Replace every value.
# Generate secrets with:  openssl rand -hex 32

# ---- Domains (example: onebank.com / admin.onebank.com / api.onebank.com) ----
WEB_URL=https://onebank.com
ADMIN_URL=https://admin.onebank.com
PUBLIC_API_URL=https://api.onebank.com/api/v1
# Parent domain shared by all three, with a leading dot:
COOKIE_DOMAIN=.onebank.com

# ---- Database (use hex: URL-special characters break DATABASE_URL) ----
POSTGRES_PASSWORD=

# ---- Secrets (each: openssl rand -hex 32) ----
JWT_ACCESS_SECRET=
JWT_ADMIN_SECRET=
# Exactly 64 hex characters. Encrypts card data and 2FA secrets: never change it after launch.
ENCRYPTION_KEY=

# ---- Cloudflare R2 (private bucket; R2 -> Manage API tokens -> Object Read & Write on this bucket) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=onebank-uploads

# ---- Email (Resend, Postmark, SES, Brevo, ...) ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="One Bank <no-reply@onebank.com>"

# ---- First superadmin (created once on first boot; remove the password afterwards) ----
SEED_ADMIN_EMAIL=you@onebank.com
SEED_ADMIN_PASSWORD=

# Cloudflare proxied (orange cloud) + Traefik = 2; set 1 if DNS is grey-cloud only.
TRUST_PROXY_HOPS=2

# Optional: comma-separated IPs allowed to reach /api/v1/admin
ADMIN_IP_ALLOWLIST=
# Set SEED_MODE=demo on a staging server to load the demo users from the README (never on production).
SEED_MODE=production
